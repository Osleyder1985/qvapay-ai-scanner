{
  "name": "qvapay-ai-scanner",
  "private": true,
  "version": "0.1.0",
  "description": "QvaPay AI Scanner",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=config/.env dist/backend/server.js",
    "dev": "npm run build && npm start",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.ts\" \"package.json\" \"tsconfig.json\"",
    "quality": "npm run lint && npm run format:check && npm test",
    "deploy:cloudflare": "npm run build && npx wrangler deploy",
    "dev:cloudflare": "npx wrangler dev",
    "d1:migrate:local": "npx wrangler d1 migrations apply qvapay-ai-scanner --local",
    "d1:migrate:remote": "npx wrangler d1 migrations apply qvapay-ai-scanner --remote",
    "smoke:cloudflare": "node scripts/cloudflare-auth-smoke.mjs",
    "smoke:cloudflare:local": "node scripts/cloudflare-local-runtime-smoke.mjs",
    "security:generate-ai-auditor-token": "node scripts/generate-ai-auditor-token.mjs",
    "governance:check": "node scripts/check-repository-governance.mjs",
    "smoke:cloudflare:production:auth-config": "node scripts/cloudflare-production-auth-config-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "wrangler": "^4.145.0"
  },
  "allowScripts": {
    "workerd@1.20260930.2": true,
    "esbuild@0.28.1": true
  }
}
