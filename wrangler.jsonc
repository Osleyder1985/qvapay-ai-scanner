{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qvapay-ai-scanner",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./src/frontend",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
