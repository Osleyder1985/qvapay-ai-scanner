{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qvapay-ai-scanner",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "QVAPAY_API_BASE_URL": "https://api.qvapay.com"
  },
  "assets": {
    "directory": "./src/frontend",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ARBITRAGE_MONITOR",
        "class_name": "ArbitrageMonitorV2"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ArbitrageMonitor"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ArbitrageMonitorV2"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qvapay-ai-scanner",
      "database_id": "839d0bc1-6f86-49ff-939a-91dc238783aa",
      "migrations_dir": "migrations"
    }
  ],
  "secrets": {
    "required": [
      "AUTH_USERNAME",
      "AUTH_PASSWORD",
      "AI_AUDITOR_TOKEN_HASH",
      "QVAPAY_APP_ID",
      "QVAPAY_APP_SECRET"
    ]
  },
  "previews": {},
  "observability": {
    "enabled": true
  }
}
